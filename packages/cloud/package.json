{
  "name": "@virtualhems/cloud",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud/API boundary for Virtual HEMS: telemetry ingestion, mission, clinical, recommendation, and AAR services.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@virtualhems/contracts": "*"
  },
  "devDependencies": {
    "@virtualhems/eslint-config": "*",
    "eslint": "^9.15.0",
    "fast-check": "^3.23.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
